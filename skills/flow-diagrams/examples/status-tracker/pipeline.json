{
  "title": "Nightly data pipeline",
  "summary": "Live status of tonight's run.",
  "live": {
    "url": "state.json",
    "every": 2
  },
  "views": [
    {
      "id": "run",
      "title": "Tonight's run",
      "kind": "flow",
      "groups": [
        {
          "id": "ingest",
          "label": "Ingest",
          "tag": "cron"
        },
        {
          "id": "build",
          "label": "Build"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "kind": "entry",
          "step": 1,
          "label": "Nightly trigger",
          "group": "ingest"
        },
        {
          "id": "fetch",
          "kind": "step",
          "step": 2,
          "label": "Fetch sources",
          "group": "ingest"
        },
        {
          "id": "valid",
          "kind": "decision",
          "step": 3,
          "label": "Schema valid?",
          "group": "build"
        },
        {
          "id": "load",
          "kind": "store",
          "step": 4,
          "label": "Load warehouse",
          "group": "build"
        },
        {
          "id": "ok",
          "kind": "exit",
          "step": 5,
          "label": "Publish report",
          "group": "build"
        },
        {
          "id": "bad",
          "kind": "error",
          "step": 6,
          "label": "Alert on-call",
          "group": "build"
        }
      ],
      "edges": [
        {
          "from": "start",
          "to": "fetch"
        },
        {
          "from": "fetch",
          "to": "valid"
        },
        {
          "from": "valid",
          "to": "load",
          "kind": "branch",
          "label": "yes"
        },
        {
          "from": "valid",
          "to": "bad",
          "kind": "branch",
          "label": "no"
        },
        {
          "from": "load",
          "to": "ok",
          "kind": "data",
          "label": "reads"
        }
      ]
    }
  ]
}
